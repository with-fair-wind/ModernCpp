# Linux + Clang profile for ModernCpp.
#
# Pairs with the clang-{debug,release,relwithdebinfo,minsizerel}-conan presets.
# Conan requires compiler.version in a complete profile, so the checked-in
# value is only a local default snapshot. Clang links against the system
# libstdc++ to get the C++23 library surface. Override compiler.version /
# libcxx when your host toolchain differs.
#
# Usage:
#   conan install . --profile:all=./conan/profiles/linux-clang \
#       --lockfile=conan.lock \
#       -s build_type=RelWithDebInfo \
#       --output-folder=build/clang-relwithdebinfo-conan \
#       --build=missing

[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=22
compiler.cppstd=23
compiler.libcxx=libstdc++11
build_type=Release
