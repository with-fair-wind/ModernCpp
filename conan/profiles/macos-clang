# macOS + (Apple) Clang profile for ModernCpp.
#
# Pairs with the clang-{debug,release,relwithdebinfo,minsizerel}-conan presets
# on Apple Silicon macOS hosts. The defaults match GitHub's macos-15 ARM64
# runner (Apple Clang 17 + libc++). Override compiler.version if a later Xcode
# is selected locally.
#
# If you use Homebrew LLVM (`brew install llvm`) instead of Apple Clang, copy
# this profile and change to:
#     compiler=clang
#     compiler.version=<Homebrew LLVM major version>
# Intel macOS requires a separate local profile with arch=x86_64; do not reuse
# this ARM64 ABI profile unchanged.
#
# Usage:
#   conan install . --profile:all=./conan/profiles/macos-clang \
#       --lockfile=conan.lock \
#       -s build_type=RelWithDebInfo \
#       --output-folder=build/clang-relwithdebinfo-conan \
#       --build=missing

[settings]
os=Macos
arch=armv8
compiler=apple-clang
compiler.version=17
compiler.cppstd=23
compiler.libcxx=libc++
build_type=Release
