# Linux + GCC profile for ModernCpp.
#
# Pairs with the gcc-{debug,release,relwithdebinfo,minsizerel}-conan presets.
# Conan requires compiler.version in a complete profile, so the checked-in
# value is only a local default snapshot. The Arch CI follows its rolling GCC
# package and overrides this field from `gcc -dumpfullversion`, ensuring that
# Conan's package ID matches the compiler that actually builds the dependency.
# Override it locally whenever your GCC major version differs.
#
# Usage:
#   conan install . --profile:all=./conan/profiles/linux-gcc \
#       --lockfile=conan.lock \
#       -s build_type=RelWithDebInfo \
#       --output-folder=build/gcc-relwithdebinfo-conan \
#       --build=missing

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=16
compiler.cppstd=23
compiler.libcxx=libstdc++11
build_type=Release
